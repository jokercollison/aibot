  "subjects": {
    "minecraft:armadillo": {
      "topics": {
        "diet": {
          "answer": "Use spider eyes to breed adult armadillos or help babies grow. An armadillo must be unrolled to accept this feeding interaction; feeding is different from brushing it for scutes.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844454",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/armadillo.json"
          ]
        }
      }
    },
    "minecraft:axolotl": {
      "topics": {
        "diet": {
          "answer": "Feed axolotls buckets of tropical fish to breed adults or help babies grow. Loose tropical fish items do not replace the bucket. Axolotls also hunt aquatic mobs such as fish and drowned, which is different from feeding them by hand.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844455",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/axolotl.json"
          ]
        }
      }
    },
    "minecraft:bee": {
      "topics": {
        "diet": {
          "answer": "Suitable flowers such as dandelions and poppies let you breed adult bees or help babies grow. Bees also visit flowers to collect pollen; pollination and feeding are different interactions. Avoid wither roses and poisonous eyeblossoms.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844630",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/bee.json"
          ]
        }
      }
    },
    "minecraft:camel": {
      "topics": {
        "diet": {
          "answer": "Cactus can heal camels, help baby camels grow and breed adults. Camels can be ridden without taming, so cactus is not a taming requirement.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3853630",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/camel.json"
          ]
        }
      }
    },
    "minecraft:camel_husk": {
      "topics": {
        "diet": {
          "answer": "A rabbit’s foot can tempt and heal a camel husk. This undead mount does not use the cactus feeding interaction of an ordinary camel.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3845813",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/camel_husk.json"
          ]
        }
      }
    },
    "minecraft:cat": {
      "topics": {
        "diet": {
          "answer": "Raw cod and raw salmon are useful for cats. They can tame a stray cat, heal a cat, help kittens grow and breed tamed adults when the breeding requirements are met. Cooked fish is not a substitute for the raw fish used to tame cats.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3853626",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/cat.json"
          ]
        }
      }
    },
    "minecraft:chicken": {
      "topics": {
        "diet": {
          "answer": "Chickens accept suitable seeds, including wheat seeds, beetroot seeds, melon seeds, pumpkin seeds, torchflower seeds and pitcher pods. Feed adults to breed them or chicks to help them grow. Wheat itself is not the same item as wheat seeds.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3850656",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/chicken.json"
          ]
        }
      }
    },
    "minecraft:cow": {
      "topics": {
        "diet": {
          "answer": "Feed wheat to adult cows for breeding or to calves to help them grow. Wheat also attracts cows. You do not tame a cow by feeding it.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3851210",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/cow.json"
          ]
        }
      }
    },
    "minecraft:dolphin": {
      "topics": {
        "diet": {
          "answer": "Feed raw cod or raw salmon to a dolphin. Adults can lead you toward nearby underwater treasure locations, and feeding a baby helps it grow. Feeding dolphins does not make them breed or become tame pets.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844640",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/dolphin.json"
          ]
        }
      }
    },
    "minecraft:donkey": {
      "topics": {
        "diet": {
          "answer": "Donkeys accept wheat, sugar, apples, carrots, golden carrots, golden apples, enchanted golden apples and hay bales for feeding uses such as growth or adult healing. Breeding tamed adults specifically uses golden carrots or golden apples, including enchanted ones; ordinary apples and wheat do not start breeding.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3850357",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/donkey.json"
          ]
        }
      }
    },
    "minecraft:fox": {
      "topics": {
        "diet": {
          "answer": "Sweet berries and glow berries breed adult foxes and help cubs grow. A fox can also eat edible items it picks up in its mouth, such as chicken; eating a carried food item is different from the berries used for breeding. Food already eaten cannot be recovered as a held-item drop.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3851723",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/fox.json"
          ]
        }
      },
      "diet_cases": [
        {
          "items": [
            "minecraft:chicken",
            "minecraft:cooked_chicken",
            "minecraft:beef",
            "minecraft:cooked_beef",
            "minecraft:apple",
            "minecraft:porkchop",
            "minecraft:cooked_porkchop",
            "minecraft:rotten_flesh"
          ],
          "answer": "A fox can eat an edible item it picks up and holds in its mouth. That is different from breeding it: use sweet berries or glow berries for breeding.",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3851723",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/fox.json"
          ]
        }
      ]
    },
    "minecraft:frog": {
      "topics": {
        "diet": {
          "answer": "Feed slimeballs to adult frogs for breeding. Frogs also swallow small slimes and small magma cubes; eating a small magma cube produces a froglight. Tadpoles use slimeballs to help them grow, and are a separate life stage from adult frogs.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844499",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/frog.json"
          ]
        }
      },
      "prey_cases": [
        {
          "aliases": [
            "slime",
            "slimes"
          ],
          "small_answer": "Frogs swallow small slimes, which drop a slimeball when eaten. Medium and large slimes are too big for frogs to swallow.",
          "large_answer": "No. Frogs only swallow the smallest slimes, not medium or large ones.",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844499",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/frog.json"
          ]
        },
        {
          "aliases": [
            "magma cube",
            "magma cubes"
          ],
          "small_answer": "Frogs swallow small magma cubes and produce a froglight. Medium and large magma cubes are too big for them to swallow.",
          "large_answer": "No. Frogs only swallow the smallest magma cubes, not medium or large ones.",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844499",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/frog.json"
          ]
        }
      ]
    },
    "minecraft:goat": {
      "topics": {
        "diet": {
          "answer": "Feed wheat to adult goats for breeding or to baby goats to help them grow. This does not tame a goat or stop its occasional ramming behavior.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844651",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/goat.json"
          ]
        }
      }
    },
    "minecraft:happy_ghast": {
      "topics": {
        "diet": {
          "answer": "Feed snowballs to a ghastling to help it become an adult happy ghast. In Bedrock, 10 snowballs can fully grow a newly spawned ghastling. Snowballs also tempt happy ghasts, but happy ghasts do not breed as a pair.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3853633",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/happy_ghast.json"
          ]
        }
      }
    },
    "minecraft:hoglin": {
      "topics": {
        "diet": {
          "answer": "Crimson fungus is the breeding food for adult hoglins and helps babies grow. Warped fungus is different: hoglins avoid it instead of using it as breeding food. Feeding does not make a hoglin a tame, harmless pet.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3843704",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/hoglin.json"
          ]
        }
      }
    },
    "minecraft:horse": {
      "topics": {
        "diet": {
          "answer": "Living horses accept wheat, sugar, apples, carrots, golden carrots, golden apples, enchanted golden apples and hay bales for feeding uses such as growth, healing or temper. Only golden carrots and golden apples, including enchanted ones, breed tamed adults. Feeding does not replace mounting a horse to tame it.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3850329",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/horse.json"
          ]
        }
      }
    },
    "minecraft:llama": {
      "topics": {
        "diet": {
          "answer": "Wheat and hay bales can heal llamas and help babies grow. To breed tamed adult llamas, use hay bales; wheat is not a breeding substitute.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844667",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/llama.json"
          ]
        }
      }
    },
    "minecraft:mooshroom": {
      "topics": {
        "diet": {
          "answer": "Wheat breeds adult mooshrooms and helps babies grow. A brown mooshroom can also accept a suitable small flower to set the effect of its next suspicious stew; that flower interaction is separate from wheat breeding.",
          "coverage": "reviewed_summary",
          "sources": [
            "https://minecraft.wiki/w/Special:PermanentLink/3844535",
            "https://github.com/Mojang/bedrock-samples/blob/46ba6ea985fb5a92d79a9419198f10dda14c199d/behavior_pack/entities/mooshroom.json"
          ]
        }
      }
    },
    "minecraft:mule": {
      "topics": {
        "diet": {
          "answer": "Mules accept wheat, sugar, apples, carrots, golden carrots, golden apples, enchanted golden apples and hay bales for growth or adult healing. A mule cannot breed even if it accepts a golden carrot or golden apple.",
          "coverage": "reviewed_summary",
          "sources": [
